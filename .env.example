###############################################################################
# Aplicación
###############################################################################
NODE_ENV=development
PORT=3000
# Límite global de peticiones por IP (ventana 60s). Solo aplica en production (en dev está desactivado).
THROTTLE_LIMIT=100

###############################################################################
# Base de datos PostgreSQL
###############################################################################
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=condupro
DATABASE_USER=condupro
DATABASE_PASSWORD=condupro

###############################################################################
# JWT
###############################################################################
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

###############################################################################
# pgAdmin (opcional)
###############################################################################
PGADMIN_DEFAULT_EMAIL=admin@condupro.local
PGADMIN_DEFAULT_PASSWORD=admin

###############################################################################
# SMTP (notificaciones por correo)
# Sin credenciales: los correos se imprimen en la consola del API (desarrollo).
# Mailtrap: crea inbox en https://mailtrap.io y pega user/pass abajo.
###############################################################################
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ConduPro <no-reply@condupro.local>"
# Pausa mínima entre dos envíos (Mailtrap free ~1 correo/s). Sube a 3000 si aún ves 550.
SMTP_MIN_INTERVAL_MS=2100

###############################################################################
# Datos de prueba (npm run seed)
# Contraseña compartida: Password123!
# admin@condupro.local | instructor1@condupro.local | instructor2@condupro.local
# student1@condupro.local | student2@condupro.local
###############################################################################
